# --- LLM (opsional; tanpa key agent berjalan dengan mode "policy") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Notifikasi Telegram (opsional; tanpa ini notifikasi dicatat sebagai "disimulasikan") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Simulator ---
TICK_SECONDS=2
AUTO_AGENT=true
DB_PATH=data/manualmechanic.db

# --- Docker Compose: login opsional (backend lokal memakai backend/.env) ---
AUTH_ENABLED=false
AUTH_TECHNICIAN_USERNAME=teknisi
AUTH_TECHNICIAN_PASSWORD_HASH=
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
