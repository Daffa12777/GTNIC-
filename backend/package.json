{
  "name": "manualmechanic-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "build:vercel": "prisma generate && tsc -p tsconfig.vercel.json && node scripts/build-vercel.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "demo:seed": "npm run build && node dist/scripts/seed-demo.js",
    "auth:setup": "npm run build && node dist/scripts/setup-local-auth.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prestart:dev": "prisma generate",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "pg": "^8.13.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "typescript": "^5.5.0"
  },
  "jest": {
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "globalTeardown": "<rootDir>/test/global-teardown.ts",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 60000
  }
}
