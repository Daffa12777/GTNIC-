# ---- Database ----
# Kosong = pakai PGlite (Postgres lokal tanpa instalasi, tersimpan di .pgdata). Untuk Supabase isi connection string
# dari Supabase > Project Settings > Database > Connection string (pilih "Session pooler", port 5432).
DATABASE_URL=

# ---- Layanan ML (FastAPI) ----
ML_URL=http://127.0.0.1:8100
ML_API_KEY=

# ---- LLM (opsional; tanpa ini agent berjalan di mode policy) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Notifikasi Telegram (opsional; tanpa ini pesan hanya dicatat) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Server ----
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
TICK_SECONDS=3
AUTO_AGENT=true
SIM_ENABLED=true
