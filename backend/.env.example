# ---- Database ----
# PostgreSQL wajib. Untuk Supabase isi connection string
# dari Supabase > Project Settings > Database > Connection string (pilih "Session pooler", port 5432).
DATABASE_URL=
DIRECT_URL=
SEED_DEMO_DATA=false

# ---- Layanan ML (FastAPI) ----
ML_URL=http://127.0.0.1:8100
ML_API_KEY=

# ---- LLM (opsional; tanpa ini agent berjalan di mode policy) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Notifikasi Telegram (opsional; tanpa ini pesan hanya dicatat) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Server ----
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
TICK_SECONDS=3
AUTO_AGENT=true
SIM_ENABLED=true
# Opsional untuk presentasi: ulangi skenario gangguan setiap backend restart (SIM_ENABLED=true).
DEMO_SCENARIO=false
# Kontrol manual simulator hanya supervisor; default false pada NODE_ENV=production.
SCENARIO_CONTROLS_ENABLED=true

# ---- Login JWT. false hanya untuk demo lokal; aktifkan untuk penggunaan tim ----
AUTH_ENABLED=true
JWT_SECRET=
AUTH_TECHNICIAN_USERNAME=teknisi
AUTH_TECHNICIAN_PASSWORD_HASH=
# Bootstrap hanya saat app_users kosong. Gunakan halaman Profil untuk perubahan berikutnya.
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD_HASH=
# Gunakan .\scripts\hash-password.ps1 dari root untuk membuat setiap hash.
# true saat memakai HTTPS. Untuk localhost HTTP tetap false.
SESSION_COOKIE_SECURE=false

# ---- Proteksi HTTP ----
# Origin harus eksplisit; tidak menerima wildcard. Proxy hanya IP/CIDR yang benar-benar dipercaya.
TRUST_PROXY=
# Fixed window bersama di PostgreSQL: umum per menit, login/sensitif per 15 menit, AI per menit.
RATE_LIMIT_MAX=600
RATE_LOGIN_MAX=20
RATE_AI_MAX=20
RATE_SENSITIVE_MAX=5
