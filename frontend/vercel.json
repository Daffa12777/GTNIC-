{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://manualmechanic-api.vercel.app/api/:path*" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/units/:id", "destination": "/index.html" },
    { "source": "/cases/:id", "destination": "/index.html" },
    { "source": "/cases", "destination": "/index.html" },
    { "source": "/work-orders", "destination": "/index.html" },
    { "source": "/inventory", "destination": "/index.html" },
    { "source": "/assistant", "destination": "/index.html" }
  ]
}
